FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir mlflow==2.18.0 SQLAlchemy==2.0.36 psycopg2-binary==2.9.10 boto3==1.35.54 && \
    pip install --no-cache-dir --force-reinstall six==1.17.0 && \
    python -c "import six; assert hasattr(six, 'string_types')"
RUN if ! grep -q '^mlflow:' /etc/passwd; then \
        printf '%s\n' 'mlflow:x:10001:10001:MLflow:/home/mlflow:/usr/sbin/nologin' >> /etc/passwd; \
    fi && \
    if ! grep -q '^mlflow:' /etc/group; then \
        printf '%s\n' 'mlflow:x:10001:' >> /etc/group; \
    fi && \
    mkdir -p /home/mlflow && \
    chown 10001:10001 /home/mlflow
USER mlflow

EXPOSE 5000

CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000"]