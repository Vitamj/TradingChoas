POSTGRES_PASSWORD=hw4-local-password
RABBITMQ_USER=hw4
RABBITMQ_PASSWORD=hw4-rabbit-password
TASK_QUEUE=tasks.bounded
QUEUE_MAX_LENGTH=11
PREFETCH_COUNT=1
MAX_DELIVERIES=3
INFERENCE_DELAY_SECONDS=0.25
GRACEFUL_TIMEOUT_SECONDS=90
MLFLOW_TRACKING_URI=http://host.docker.internal:5000
MODEL_NAME=BrentDirectionModel
MODEL_ALIAS=champion
DATA_PATH=/data/brent_prices.csv
SOURCE_TASK_COUNT=180
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
LOG_LEVEL=INFO
DEPLOYMENT_ENVIRONMENT=dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_SDK_DISABLED=false
GRAFANA_ADMIN_PASSWORD=hw5-grafana-password
OBSERVABILITY_RETENTION=48h
COMPOSE_PROJECT_NAME=mlflow_hw4
